{
  "$schema": "./tokens.schema.json",
  "name": "Talent.OS",
  "version": "0.1.0",
  "primitive": {
    "color": {
      "paper": "#eeede9",
      "white": "#ffffff",
      "ink": "#20211f",
      "muted": "#62645f",
      "line": "#81847c",
      "soft": "#d9dbd3",
      "yellow": "#f5df49",
      "yellowHover": "#e4cd32",
      "cyan": "#74dce0",
      "cyanLight": "#def6f5",
      "purple": "#432052",
      "purpleLight": "#f2eaf6",
      "green": "#245e3d",
      "greenLight": "#e5f2e8",
      "red": "#a6291b",
      "redLight": "#fbece8",
      "blue": "#214d9b",
      "blueLight": "#e9effb",
      "amber": "#745100",
      "amberLight": "#fff4c9",
      "overlay": "#20211f99"
    },
    "space": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px"
    },
    "font": {
      "sans": "\"IBM Plex Sans\", Arial, sans-serif",
      "mono": "\"IBM Plex Mono\", monospace",
      "editorial": "Georgia, \"Times New Roman\", serif"
    },
    "fontSize": {
      "micro": "0.75rem",
      "small": "0.875rem",
      "body": "1rem",
      "lead": "1.25rem",
      "h3": "1.5rem",
      "h2": "2rem",
      "h1": "clamp(2.5rem, 5vw, 4rem)"
    },
    "radius": {
      "none": "0px",
      "small": "4px",
      "medium": "8px",
      "full": "999px"
    },
    "shadow": {
      "none": "none",
      "hard": "5px 5px 0 #20211f",
      "soft": "0 4px 16px #20211f26"
    },
    "duration": {
      "instant": "0ms",
      "fast": "120ms",
      "normal": "180ms",
      "spin": "900ms"
    },
    "ease": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)"
    }
  },
  "semantic": {
    "color": {
      "canvas": "{primitive.color.paper}",
      "surface": "{primitive.color.white}",
      "text": "{primitive.color.ink}",
      "muted": "{primitive.color.muted}",
      "border": "{primitive.color.line}",
      "divider": "{primitive.color.soft}",
      "action": "{primitive.color.yellow}",
      "action-hover": "{primitive.color.yellowHover}",
      "on-action": "{primitive.color.ink}",
      "inverse": "{primitive.color.ink}",
      "on-inverse": "{primitive.color.white}",
      "focus": "{primitive.color.blue}",
      "accent": "{primitive.color.cyan}",
      "accent-soft": "{primitive.color.cyanLight}",
      "editorial": "{primitive.color.purple}",
      "editorial-soft": "{primitive.color.purpleLight}",
      "success": "{primitive.color.green}",
      "success-soft": "{primitive.color.greenLight}",
      "danger": "{primitive.color.red}",
      "danger-soft": "{primitive.color.redLight}",
      "info": "{primitive.color.blue}",
      "info-soft": "{primitive.color.blueLight}",
      "warning": "{primitive.color.amber}",
      "warning-soft": "{primitive.color.amberLight}",
      "overlay": "{primitive.color.overlay}"
    },
    "font": {
      "body": "{primitive.font.sans}",
      "utility": "{primitive.font.mono}",
      "quote": "{primitive.font.editorial}"
    },
    "text": {
      "micro": "{primitive.fontSize.micro}",
      "small": "{primitive.fontSize.small}",
      "body": "{primitive.fontSize.body}",
      "lead": "{primitive.fontSize.lead}",
      "h3": "{primitive.fontSize.h3}",
      "h2": "{primitive.fontSize.h2}",
      "h1": "{primitive.fontSize.h1}"
    },
    "space": {
      "none": "{primitive.space.0}",
      "xs": "{primitive.space.1}",
      "sm": "{primitive.space.2}",
      "md": "{primitive.space.3}",
      "lg": "{primitive.space.4}",
      "xl": "{primitive.space.6}",
      "2xl": "{primitive.space.8}",
      "3xl": "{primitive.space.12}",
      "4xl": "{primitive.space.16}"
    },
    "radius": {
      "none": "{primitive.radius.none}",
      "control": "{primitive.radius.small}",
      "compact": "{primitive.radius.medium}",
      "pill": "{primitive.radius.full}"
    },
    "shadow": {
      "none": "{primitive.shadow.none}",
      "window": "{primitive.shadow.hard}",
      "floating": "{primitive.shadow.soft}"
    },
    "motion": {
      "fast": "{primitive.duration.fast}",
      "normal": "{primitive.duration.normal}",
      "ease": "{primitive.ease.standard}",
      "spin": "{primitive.duration.spin}"
    },
    "line": {
      "body": "1.5",
      "heading": "1.08",
      "utility": "1.4"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "strong": "600",
      "bold": "700"
    },
    "border": {
      "thin": "1px",
      "strong": "2px",
      "focus": "3px"
    },
    "size": {
      "control": "44px",
      "icon": "20px",
      "avatar": "48px",
      "spinner": "20px",
      "slider": "6px"
    },
    "layout": {
      "container": "1200px",
      "reading": "68ch",
      "sidebar": "240px",
      "dialog": "480px",
      "popover": "320px",
      "grid-min": "260px",
      "gutter": "24px"
    },
    "layer": {
      "overlay": "40",
      "floating": "50",
      "toast": "60"
    },
    "opacity": {
      "disabled": "0.55",
      "subtle": "0.75"
    }
  }
}
