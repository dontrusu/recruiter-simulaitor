{
  "name": "talent-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "prettier --write src scripts e2e *.ts *.json",
    "format:check": "prettier --check src scripts e2e *.ts *.json",
    "simulate": "SIMULATION_SEEDS=1000 vitest run src/game/simulation.test.ts",
    "validate:content": "vitest run src/game/content.test.ts",
    "test:production": "npm run build && playwright test --config playwright.production.config.ts",
    "check": "npm run typecheck && npm test && npm run format:check"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "@playwright/test": "^1.63.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
