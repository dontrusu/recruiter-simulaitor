{
  "name": "talent-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write src scripts e2e *.ts *.json .github/workflows/ci.yml .oxlintrc.json lefthook.yml pnpm-workspace.yaml",
    "format:check": "prettier --check src scripts e2e *.ts *.json .github/workflows/ci.yml .oxlintrc.json lefthook.yml pnpm-workspace.yaml",
    "test:production": "pnpm run build && playwright test --config playwright.production.config.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run format:check"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.1.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.71.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^31.0.0",
    "lefthook": "^2.2.2",
    "oxlint": "^1.91.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.16.1"
}
